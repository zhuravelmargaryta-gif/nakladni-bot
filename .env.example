# ============================================================
#  Налаштування бота обліку накладних
#  Заповніть значення після знаку "=" (без лапок і пробілів),
#  збережіть файл (Ctrl+S) і запустіть run.bat ще раз.
# ============================================================

# --- ОБОВ'ЯЗКОВО ---

# Токен бота від @BotFather (див. README, крок 1). Приклад: 7123456789:AAH...
BOT_TOKEN=

# Ключ Google Gemini з https://aistudio.google.com/apikey (README, крок 2)
GEMINI_API_KEY=

# Модель розпізнавання. Зазвичай змінювати не потрібно.
GEMINI_MODEL=gemini-2.5-flash

# --- ДОСТУП ---

# Telegram ID співробітників, яким дозволено користуватися ботом, через кому.
# Свій ID можна дізнатися командою /myid у боті.
# УВАГА: якщо залишити порожнім — ботом зможе користуватися БУДЬ-ХТО!
ALLOWED_USERS=

# Адміністратори (можуть редагувати й видаляти будь-які записи), через кому.
# Якщо порожньо — усі користувачі можуть редагувати все.
ADMIN_IDS=

# --- НАША КОМПАНІЯ ---

# ЄДРПОУ (або ІПН) нашої компанії. Якщо постачальник у накладній — це ми,
# контрагентом вважатиметься покупець. Можна залишити порожнім.
OUR_COMPANY_CODE=

# Файл бази даних (зазвичай не змінювати)
DB_PATH=invoices.db

# --- ODOO (необов'язково) ---
# Якщо не заповнено — бот повністю працює сам, без Odoo.

# Адреса Odoo, напр. https://mycompany.odoo.com
ODOO_URL=
# Назва бази даних Odoo (для Odoo Online зазвичай збігається з піддоменом: mycompany)
ODOO_DB=
# Логін (email) користувача Odoo
ODOO_USER=
# API-ключ користувача Odoo (README, крок 6)
ODOO_API_KEY=

# Автоматично відправляти нові накладні в Odoo (true / false)
ODOO_AUTO_SYNC=true
# Поле контрагента в Odoo, де зберігається ЄДРПОУ (company_registry або vat)
ODOO_PARTNER_CODE_FIELD=company_registry
# ID податку "ПДВ 20% (закупівля)" в Odoo. Якщо задано — ціни в рядках вважаються БЕЗ ПДВ
# і до них додається цей податок. Якщо порожньо — ціни йдуть як є, без податків.
ODOO_PURCHASE_TAX_ID=
# ID журналу закупівель (необов'язково)
ODOO_JOURNAL_ID=
# ID рахунку витрат для рядків (необов'язково)
ODOO_EXPENSE_ACCOUNT_ID=
